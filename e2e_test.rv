import std/env { get_env_or, has_env }
import std/string
import std/test { assert_eq_int, assert_eq_str, assert_msg, assert_true }
import "./lib" { connect, Connection }

fun e2e_enabled() -> Bool {
    return has_env("RAVEN_MYSQL_E2E")
}

fun mysql_port() -> Int {
    return match get_env_or("RAVEN_MYSQL_PORT", "33306").parse_int() {
        Some(port) -> port,
        None -> 33306,
    }
}

fun must<T>(result: Result<T, Error>) -> T {
    return match result {
        Ok(value) -> value,
        Err(e) -> {
            __panic(e.message())
            must(result)
        },
    }
}

fun open_test_db() -> Connection {
    return must(
        connect(
            get_env_or("RAVEN_MYSQL_HOST", "127.0.0.1"),
            mysql_port(),
            get_env_or("RAVEN_MYSQL_USER", "raven"),
            get_env_or("RAVEN_MYSQL_PASSWORD", "ravenpw"),
            get_env_or("RAVEN_MYSQL_DATABASE", "ravendb"),
        ),
    )
}

fun repeated_text(value: String, target_length: Int) -> String {
    let out = value
    while out.length() < target_length {
        out = out.concat(out)
    }
    return out.substring(0, target_length)
}

fun test_e2e_connect_and_server_metadata() {
    if !e2e_enabled() {
        return
    }
    let conn = open_test_db()
    assert_true(conn.server_version.length() > 0)
    assert_true(conn.connection_id > 0)
    let result = must(
        conn.query("SELECT VERSION() AS version, DATABASE() AS db, CONNECTION_ID() AS id"),
    )
    assert_eq_int(result.row_count(), 1)
    assert_eq_str(result.columns[0], "version")
    assert_eq_str(result.columns[1], "db")
    assert_eq_str(result.rows[0].get(1), get_env_or("RAVEN_MYSQL_DATABASE", "ravendb"))
    assert_eq_str(result.rows[0].get(2), "${conn.connection_id}")
    conn.close()
}

fun test_e2e_ping_and_database_selection() {
    if !e2e_enabled() {
        return
    }
    let conn = open_test_db()
    assert_msg(must(conn.ping()), "initial COM_PING returned false")
    assert_msg(
        must(conn.select_database(get_env_or("RAVEN_MYSQL_DATABASE", "ravendb"))),
        "COM_INIT_DB returned false",
    )
    assert_eq_str(must(conn.query("SELECT DATABASE()")).rows[0].get(0), "ravendb")
    match conn.select_database("raven_mysql_database_that_does_not_exist") {
        Ok(ok) -> assert_msg(false, "expected unknown database to fail"),
        Err(e) -> assert_msg(
            e.message().contains("ERROR 1044") || e.message().contains("ERROR 1049"),
            e.message(),
        ),
    }
    assert_msg(must(conn.ping()), "COM_PING after INIT_DB error returned false")
    conn.close()
}

fun test_e2e_create_insert_and_select_rows() {
    if !e2e_enabled() {
        return
    }
    let conn = open_test_db()
    let _ = must(conn.execute("DROP TABLE IF EXISTS raven_mysql_basic"))
    let _ = must(
        conn.execute(
            "CREATE TABLE raven_mysql_basic (id BIGINT PRIMARY KEY AUTO_INCREMENT, name VARCHAR(100), score DECIMAL(8,2))",
        ),
    )
    assert_eq_int(
        must(
            conn.execute(
                "INSERT INTO raven_mysql_basic (name, score) VALUES ('Ada', 9.50), ('Grace', 8.25), ('Linus', 7.00)",
            ),
        ),
        3,
    )
    let result = must(conn.query("SELECT id, name, score FROM raven_mysql_basic ORDER BY id"))
    assert_eq_int(result.row_count(), 3)
    assert_eq_str(result.rows[0].get(0), "1")
    assert_eq_str(result.rows[1].get(1), "Grace")
    assert_eq_str(result.rows[2].get(2), "7.00")
    let _ = must(conn.execute("DROP TABLE raven_mysql_basic"))
    conn.close()
}

fun test_e2e_parameters_cannot_change_sql_syntax() {
    if !e2e_enabled() {
        return
    }
    let conn = open_test_db()
    let _ = must(conn.execute("DROP TABLE IF EXISTS raven_mysql_params"))
    let _ = must(conn.execute("CREATE TABLE raven_mysql_params (value TEXT NOT NULL)"))
    let hostile = "O'Brien'); DROP TABLE raven_mysql_params; --"
    assert_eq_int(
        must(conn.execute_params("INSERT INTO raven_mysql_params VALUES (?)", [hostile])),
        1,
    )
    let result = must(
        conn.query_params("SELECT value FROM raven_mysql_params WHERE value = ?", [hostile]),
    )
    assert_eq_int(result.row_count(), 1)
    assert_eq_str(result.rows[0].get(0), hostile)
    assert_eq_int(must(conn.query("SELECT COUNT(*) FROM raven_mysql_params")).row_count(), 1)
    let _ = must(conn.execute("DROP TABLE raven_mysql_params"))
    conn.close()
}

fun test_e2e_null_and_empty_string_remain_distinct() {
    if !e2e_enabled() {
        return
    }
    let conn = open_test_db()
    let _ = must(conn.execute("DROP TABLE IF EXISTS raven_mysql_nulls"))
    let _ = must(
        conn.execute(
            "CREATE TABLE raven_mysql_nulls (nullable_value TEXT NULL, empty_value TEXT NOT NULL)",
        ),
    )
    let params: List<Option<String>> = [None, Some("")]
    assert_eq_int(
        must(conn.execute_optional_params("INSERT INTO raven_mysql_nulls VALUES (?, ?)", params)),
        1,
    )
    let result = must(conn.query("SELECT nullable_value, empty_value FROM raven_mysql_nulls"))
    assert_true(result.rows[0].is_null(0))
    assert_eq_str(result.rows[0].get(0), "")
    assert_true(!result.rows[0].is_null(1))
    assert_eq_str(result.rows[0].get(1), "")
    let _ = must(conn.execute("DROP TABLE raven_mysql_nulls"))
    conn.close()
}

fun test_e2e_connection_recovers_after_sql_error() {
    if !e2e_enabled() {
        return
    }
    let conn = open_test_db()
    match conn.query("SELECT * FROM raven_mysql_table_that_does_not_exist") {
        Ok(result) -> assert_msg(false, "expected missing-table query to fail"),
        Err(e) -> {
            assert_eq_str(e.kind(), "mysql")
            assert_true(e.message().contains("ERROR 1146"))
        },
    }
    let result = must(conn.query("SELECT 42 AS answer"))
    assert_eq_str(result.rows[0].get(0), "42")
    conn.close()
}

fun test_e2e_insert_id_and_affected_rows() {
    if !e2e_enabled() {
        return
    }
    let conn = open_test_db()
    let _ = must(conn.execute("DROP TABLE IF EXISTS raven_mysql_counts"))
    let _ = must(
        conn.execute(
            "CREATE TABLE raven_mysql_counts (id BIGINT PRIMARY KEY AUTO_INCREMENT, value VARCHAR(30) NOT NULL)",
        ),
    )
    let inserted = must(
        conn.query("INSERT INTO raven_mysql_counts (value) VALUES ('one'), ('two')"),
    )
    assert_eq_int(inserted.affected, 2)
    assert_eq_int(inserted.last_insert_id, 1)
    assert_eq_int(must(conn.execute("UPDATE raven_mysql_counts SET value = UPPER(value)")), 2)
    assert_eq_int(must(conn.execute("DELETE FROM raven_mysql_counts WHERE id = 2")), 1)
    assert_eq_str(must(conn.query("SELECT COUNT(*) FROM raven_mysql_counts")).rows[0].get(0), "1")
    let _ = must(conn.execute("DROP TABLE raven_mysql_counts"))
    conn.close()
}

fun test_e2e_transaction_rollback() {
    if !e2e_enabled() {
        return
    }
    let conn = open_test_db()
    let _ = must(conn.execute("DROP TABLE IF EXISTS raven_mysql_rollback"))
    let _ = must(
        conn.execute("CREATE TABLE raven_mysql_rollback (value INT NOT NULL) ENGINE=InnoDB"),
    )
    let _ = must(conn.execute("START TRANSACTION"))
    let _ = must(conn.execute("INSERT INTO raven_mysql_rollback VALUES (1), (2)"))
    let _ = must(conn.execute("ROLLBACK"))
    assert_eq_str(must(conn.query("SELECT COUNT(*) FROM raven_mysql_rollback")).rows[0].get(0), "0")
    let _ = must(conn.execute("DROP TABLE raven_mysql_rollback"))
    conn.close()
}

fun test_e2e_transaction_commit() {
    if !e2e_enabled() {
        return
    }
    let conn = open_test_db()
    let _ = must(conn.execute("DROP TABLE IF EXISTS raven_mysql_commit"))
    let _ = must(conn.execute("CREATE TABLE raven_mysql_commit (value INT NOT NULL) ENGINE=InnoDB"))
    let _ = must(conn.execute("START TRANSACTION"))
    let _ = must(conn.execute("INSERT INTO raven_mysql_commit VALUES (7)"))
    let _ = must(conn.execute("COMMIT"))
    assert_eq_str(must(conn.query("SELECT value FROM raven_mysql_commit")).rows[0].get(0), "7")
    let _ = must(conn.execute("DROP TABLE raven_mysql_commit"))
    conn.close()
}

fun test_e2e_column_metadata_and_empty_result_set() {
    if !e2e_enabled() {
        return
    }
    let conn = open_test_db()
    let _ = must(conn.execute("DROP TABLE IF EXISTS raven_mysql_metadata"))
    let _ = must(
        conn.execute(
            "CREATE TABLE raven_mysql_metadata (id BIGINT PRIMARY KEY, label VARCHAR(40) NOT NULL)",
        ),
    )
    let result = must(
        conn.query("SELECT id AS item_id, label FROM raven_mysql_metadata WHERE 1 = 0"),
    )
    assert_eq_int(result.row_count(), 0)
    assert_eq_int(result.columns.len(), 2)
    assert_eq_str(result.columns[0], "item_id")
    assert_eq_str(result.fields[0].table, "raven_mysql_metadata")
    assert_eq_str(result.fields[0].database, get_env_or("RAVEN_MYSQL_DATABASE", "ravendb"))
    assert_eq_int(result.fields[0].column_type, 8)
    assert_eq_int(result.fields[1].column_type, 253)
    let _ = must(conn.execute("DROP TABLE raven_mysql_metadata"))
    conn.close()
}

fun test_e2e_scalar_types_are_returned_as_text() {
    if !e2e_enabled() {
        return
    }
    let conn = open_test_db()
    let result = must(
        conn.query(
            "SELECT CAST(-42 AS SIGNED) AS signed_value, CAST(123.45 AS DECIMAL(8,2)) AS decimal_value, DATE('2026-07-14') AS date_value, TIME('12:34:56') AS time_value",
        ),
    )
    assert_eq_str(result.rows[0].get(0), "-42")
    assert_eq_str(result.rows[0].get(1), "123.45")
    assert_eq_str(result.rows[0].get(2), "2026-07-14")
    assert_eq_str(result.rows[0].get(3), "12:34:56")
    conn.close()
}

fun test_e2e_unicode_and_control_bytes_round_trip() {
    if !e2e_enabled() {
        return
    }
    let conn = open_test_db()
    let _ = must(conn.execute("DROP TABLE IF EXISTS raven_mysql_bytes"))
    let _ = must(
        conn.execute("CREATE TABLE raven_mysql_bytes (id INT PRIMARY KEY, value LONGTEXT NOT NULL)"),
    )
    let unicode = "Raven says salam: Bakı 🐦"
    let with_nul = "before".concat(__str_from_byte(0)).concat("after")
    let _ = must(conn.execute_params("INSERT INTO raven_mysql_bytes VALUES (1, ?)", [unicode]))
    let _ = must(conn.execute_params("INSERT INTO raven_mysql_bytes VALUES (2, ?)", [with_nul]))
    let result = must(conn.query("SELECT value FROM raven_mysql_bytes ORDER BY id"))
    assert_eq_str(result.rows[0].get(0), unicode)
    assert_eq_str(result.rows[1].get(0), with_nul)
    let _ = must(conn.execute("DROP TABLE raven_mysql_bytes"))
    conn.close()
}

fun test_e2e_large_parameter_and_result_round_trip() {
    if !e2e_enabled() {
        return
    }
    let conn = open_test_db()
    let _ = must(conn.execute("DROP TABLE IF EXISTS raven_mysql_large"))
    let _ = must(conn.execute("CREATE TABLE raven_mysql_large (value MEDIUMTEXT NOT NULL)"))
    let value = repeated_text("raven-mysql-", 262144)
    assert_eq_int(must(conn.execute_params("INSERT INTO raven_mysql_large VALUES (?)", [value])), 1)
    let result = must(conn.query("SELECT value FROM raven_mysql_large"))
    assert_eq_int(result.rows[0].get(0).length(), 262144)
    assert_eq_str(result.rows[0].get(0), value)
    let _ = must(conn.execute("DROP TABLE raven_mysql_large"))
    conn.close()
}

fun test_e2e_many_rows_preserve_order_and_boundaries() {
    if !e2e_enabled() {
        return
    }
    let conn = open_test_db()
    let _ = must(conn.execute("DROP TABLE IF EXISTS raven_mysql_many"))
    let _ = must(
        conn.execute(
            "CREATE TABLE raven_mysql_many (id INT PRIMARY KEY, value VARCHAR(30) NOT NULL)",
        ),
    )
    let sql = "INSERT INTO raven_mysql_many VALUES "
    let i = 1
    while i <= 200 {
        if i > 1 {
            sql = sql.concat(",")
        }
        sql = sql.concat("(${i}, 'row-${i}')")
        i = i + 1
    }
    assert_eq_int(must(conn.execute(sql)), 200)
    let result = must(conn.query("SELECT id, value FROM raven_mysql_many ORDER BY id"))
    assert_eq_int(result.row_count(), 200)
    assert_eq_str(result.rows[0].get(1), "row-1")
    assert_eq_str(result.rows[99].get(1), "row-100")
    assert_eq_str(result.rows[199].get(1), "row-200")
    let _ = must(conn.execute("DROP TABLE raven_mysql_many"))
    conn.close()
}

fun test_e2e_separate_connections_observe_committed_writes() {
    if !e2e_enabled() {
        return
    }
    let writer = open_test_db()
    let reader = open_test_db()
    let _ = must(writer.execute("DROP TABLE IF EXISTS raven_mysql_connections"))
    let _ = must(
        writer.execute("CREATE TABLE raven_mysql_connections (value VARCHAR(20) NOT NULL)"),
    )
    let _ = must(writer.execute("INSERT INTO raven_mysql_connections VALUES ('visible')"))
    let result = must(reader.query("SELECT value FROM raven_mysql_connections"))
    assert_eq_str(result.rows[0].get(0), "visible")
    let _ = must(writer.execute("DROP TABLE raven_mysql_connections"))
    reader.close()
    writer.close()
}

fun test_e2e_bound_values_ignore_session_escape_mode() {
    if !e2e_enabled() {
        return
    }
    let conn = open_test_db()
    let _ = must(conn.execute("DROP TABLE IF EXISTS raven_mysql_sql_mode"))
    let _ = must(conn.execute("CREATE TABLE raven_mysql_sql_mode (value TEXT NOT NULL)"))
    let _ = must(conn.execute("SET SESSION sql_mode = 'NO_BACKSLASH_ESCAPES'"))
    let value = "backslash \\ and quote ' and question ?"
    let _ = must(conn.execute_params("INSERT INTO raven_mysql_sql_mode VALUES (?)", [value]))
    let result = must(
        conn.query_params("SELECT value FROM raven_mysql_sql_mode WHERE value = ?", [value]),
    )
    assert_eq_str(result.rows[0].get(0), value)
    let _ = must(conn.execute("DROP TABLE raven_mysql_sql_mode"))
    conn.close()
}

fun test_e2e_server_warning_count_is_reported() {
    if !e2e_enabled() {
        return
    }
    let conn = open_test_db()
    let result = must(conn.query("SELECT CAST('not-a-number' AS UNSIGNED) AS coerced"))
    assert_eq_str(result.rows[0].get(0), "0")
    assert_true(result.warnings > 0)
    conn.close()
}

fun test_e2e_multi_packet_query_and_result() {
    if !e2e_enabled() {
        return
    }
    let conn = open_test_db()
    let large_result = must(conn.query("SELECT REPEAT('z', 17000000) AS payload"))
    assert_eq_int(large_result.rows[0].get(0).length(), 17000000)

    let padding = repeated_text("x", 16777216)
    let large_query = "SELECT 1 AS answer /*".concat(padding).concat("*/")
    let result = must(conn.query(large_query))
    assert_eq_str(result.rows[0].get(0), "1")
    conn.close()
}
