// raven-mysql: a MySQL client written in pure Raven.
//
// It speaks the MySQL client/server protocol directly over std/net. The first
// release supports mysql_native_password authentication, text-protocol SQL,
// and result rows represented as strings with explicit SQL NULL tracking.

import std.net
from std.net import TcpStream
import std.string
from std.error import error_kind
from "./protocol" import byte, byte_at, hex, int4_le, LenEnc, native_password_token, read_int2_le, read_int4_le, read_lenenc, read_packet_from, write_packet

let CLIENT_LONG_PASSWORD: int = 1
let CLIENT_LONG_FLAG: int = 4
let CLIENT_CONNECT_WITH_DB: int = 8
let CLIENT_PROTOCOL_41: int = 512
let CLIENT_TRANSACTIONS: int = 8192
let CLIENT_SECURE_CONNECTION: int = 32768
let CLIENT_PLUGIN_AUTH: int = 524288
let UTF8MB4_GENERAL_CI: int = 45

class Connection {
    stream: TcpStream
    server_version: str
    connection_id: int
}

// Metadata for one result-set column.
class Column {
    name: str
    table: str
    database: str
    column_type: int
    flags: int
    charset: int
}

// A text-protocol row. SQL NULL has an empty value and a true null marker.
class Row {
    values: list[str]
    nulls: list[bool]
}

// The complete response to one SQL statement.
class QueryResult {
    columns: list[str]
    fields: list[Column]
    rows: list[Row]
    affected: int
    last_insert_id: int
    warnings: int
}

class Handshake {
    capabilities: int
    scramble: str
    plugin: str
    server_version: str
    connection_id: int
}

class AuthSwitch {
    plugin: str
    scramble: str
}

fun zeroes(count: int) -> str {
    var out = ""
    var i = 0
    while i < count {
        out = out.concat(byte(0))
        i = i + 1
    }
    return out
}

fun cstr(value: str) -> str {
    return value.concat(byte(0))
}

fun is_sql_space(value: int) -> bool {
    return value == 9 or value == 10 or value == 11 or value == 12 or value == 13 or value == 32
}

fun sql_text_literal(value: str) -> str {
    return "_utf8mb4 X'${hex(value)}'"
}

// Substitute only syntactic `?` placeholders. Question marks inside quoted
// strings, quoted identifiers, and all MySQL comment forms are left untouched.
// Values become hexadecimal literals, so quotes and control bytes cannot alter
// the surrounding SQL and the current backslash-escape mode is irrelevant.
fun bind_sql_params_mode(
    sql: str,
    params: list[Option[str]],
    backslash_escapes: bool,
) -> Result[str, Error] {
    let normal = 0
    let single_quote = 1
    let double_quote = 2
    let backtick = 3
    let line_comment = 4
    let block_comment = 5

    var state = normal
    var out = ""
    var i = 0
    var param_index = 0
    while i < sql.length() {
        let current = byte_at(sql, i)
        let next = byte_at(sql, i + 1) if i + 1 < sql.length() else -1

        if state == normal {
            if current == 63 {
                if param_index >= params.len() {
                    return Err(error_kind("mysql", "not enough parameters for SQL placeholders"))
                }
                match params[param_index] {
                    case Some(value) {
                        out = out.concat(sql_text_literal(value))
                    }
                    case None {
                        out = out.concat("NULL")
                    }
                }
                param_index = param_index + 1
            } else {
                out = out.concat(byte(current))
                if current == 39 {
                    state = single_quote
                } else if current == 34 {
                    state = double_quote
                } else if current == 96 {
                    state = backtick
                } else if current == 35 {
                    state = line_comment
                } else if current == 45 and next == 45 and i + 2 < sql.length() and is_sql_space(byte_at(sql, i + 2)) {
                    out = out.concat(byte(next))
                    i = i + 1
                    state = line_comment
                } else if current == 47 and next == 42 {
                    out = out.concat(byte(next))
                    i = i + 1
                    state = block_comment
                }
            }
        } else if state == line_comment {
            out = out.concat(byte(current))
            if current == 10 or current == 13 {
                state = normal
            }
        } else if state == block_comment {
            out = out.concat(byte(current))
            if current == 42 and next == 47 {
                out = out.concat(byte(next))
                i = i + 1
                state = normal
            }
        } else {
            out = out.concat(byte(current))
            let delimiter = if state == single_quote {
                39
            } else if state == double_quote {
                34
            } else {
                96
            }
            if backslash_escapes and current == 92 and next >= 0 {
                out = out.concat(byte(next))
                i = i + 1
            } else if current == delimiter and next == delimiter {
                out = out.concat(byte(next))
                i = i + 1
            } else if current == delimiter {
                state = normal
            }
        }
        i = i + 1
    }

    if param_index != params.len() {
        return Err(error_kind("mysql", "too many parameters for SQL placeholders"))
    }
    return Ok(out)
}

// Bind parameters using MySQL's default backslash-escape string mode.
fun bind_sql_params(sql: str, params: list[Option[str]]) -> Result[str, Error] {
    return bind_sql_params_mode(sql, params, true)
}

// Bind parameters for a session whose sql_mode contains NO_BACKSLASH_ESCAPES.
fun bind_sql_params_no_backslash_escapes(
    sql: str,
    params: list[Option[str]],
) -> Result[str, Error] {
    return bind_sql_params_mode(sql, params, false)
}

fun text_params(params: list[str]) -> list[Option[str]] {
    let out: list[Option[str]] = []
    for value in params {
        out.push(Some(value))
    }
    return out
}

fun find_nul(data: str, start: int) -> int {
    var i = start
    while i < data.length() {
        if byte_at(data, i) == 0 {
            return i
        }
        i = i + 1
    }
    return data.length()
}

fun strip_trailing_nul(data: str) -> str {
    if data.length() > 0 and byte_at(data, data.length() - 1) == 0 {
        return data.substring(0, data.length() - 1)
    }
    return data
}

fun parse_server_error(payload: str) -> Error {
    if payload.length() < 3 {
        return error_kind("mysql", "malformed error packet")
    }
    let code = read_int2_le(payload, 1)
    var state = "HY000"
    var message_offset = 3
    if payload.length() >= 9 and byte_at(payload, 3) == 35 {
        state = payload.substring(4, 9)
        message_offset = 9
    }
    let message = payload.substring(message_offset, payload.length())
    return error_kind("mysql", "ERROR ${code} (${state}): ${message}")
}

fun read_lenenc_checked(payload: str, offset: int) -> Result[LenEnc, Error] {
    if offset < 0 or offset >= payload.length() {
        return Err(error_kind("mysql", "truncated length-encoded integer"))
    }
    let marker = byte_at(payload, offset)
    var required = 1
    if marker == 252 {
        required = 3
    } else if marker == 253 {
        required = 4
    } else if marker >= 254 {
        required = 9
    }
    if offset + required > payload.length() {
        return Err(error_kind("mysql", "truncated length-encoded integer"))
    }
    if marker == 255 {
        return Err(error_kind("mysql", "invalid length-encoded integer marker"))
    }
    return Ok(read_lenenc(payload, offset))
}

fun lenenc_string_at(payload: str, offset: int) -> Result[str, Error] {
    if offset >= payload.length() {
        return Err(error_kind("mysql", "truncated length-encoded string"))
    }
    let length = read_lenenc_checked(payload, offset)?
    if length.is_null or length.next + length.value > payload.length() {
        return Err(error_kind("mysql", "malformed length-encoded string"))
    }
    return Ok(payload.substring(length.next, length.next + length.value))
}

fun skip_lenenc_string(payload: str, offset: int) -> Result[int, Error] {
    if offset >= payload.length() {
        return Err(error_kind("mysql", "truncated column definition"))
    }
    let length = read_lenenc_checked(payload, offset)?
    if length.is_null or length.next + length.value > payload.length() {
        return Err(error_kind("mysql", "malformed column definition"))
    }
    return Ok(length.next + length.value)
}

fun parse_column(payload: str) -> Result[Column, Error] {
    var offset = 0
    let _catalog = lenenc_string_at(payload, offset)?
    offset = skip_lenenc_string(payload, offset)?
    let database = lenenc_string_at(payload, offset)?
    offset = skip_lenenc_string(payload, offset)?
    let table = lenenc_string_at(payload, offset)?
    offset = skip_lenenc_string(payload, offset)?
    offset = skip_lenenc_string(payload, offset)?
    let name = lenenc_string_at(payload, offset)?
    offset = skip_lenenc_string(payload, offset)?
    offset = skip_lenenc_string(payload, offset)?

    if offset >= payload.length() {
        return Err(error_kind("mysql", "truncated column definition metadata"))
    }
    let fixed = read_lenenc_checked(payload, offset)?
    offset = fixed.next
    if fixed.value < 12 or offset + fixed.value > payload.length() {
        return Err(error_kind("mysql", "malformed column definition metadata"))
    }
    let charset = read_int2_le(payload, offset)
    let column_type = byte_at(payload, offset + 6)
    let flags = read_int2_le(payload, offset + 7)
    return Ok(
        Column(
            name: name,
            table: table,
            database: database,
            column_type: column_type,
            flags: flags,
            charset: charset,
        ),
    )
}

fun parse_text_row(payload: str, column_count: int) -> Result[Row, Error] {
    let values: list[str] = []
    let nulls: list[bool] = []
    var offset = 0
    var i = 0
    while i < column_count {
        if offset >= payload.length() {
            return Err(error_kind("mysql", "truncated result row"))
        }
        let length = read_lenenc_checked(payload, offset)?
        offset = length.next
        if length.is_null {
            values.push("")
            nulls.push(true)
        } else {
            if offset + length.value > payload.length() {
                return Err(error_kind("mysql", "malformed result row"))
            }
            values.push(payload.substring(offset, offset + length.value))
            nulls.push(false)
            offset = offset + length.value
        }
        i = i + 1
    }
    if offset != payload.length() {
        return Err(error_kind("mysql", "result row has trailing data"))
    }
    return Ok(Row(values: values, nulls: nulls))
}

fun empty_result() -> QueryResult {
    let columns: list[str] = []
    let fields: list[Column] = []
    let rows: list[Row] = []
    return QueryResult(
        columns: columns,
        fields: fields,
        rows: rows,
        affected: 0,
        last_insert_id: 0,
        warnings: 0,
    )
}

fun parse_ok(payload: str) -> Result[QueryResult, Error] {
    if payload.length() == 0 or byte_at(payload, 0) != 0 {
        return Err(error_kind("mysql", "malformed OK packet"))
    }
    let affected_value = read_lenenc_checked(payload, 1)?
    let insert_value = read_lenenc_checked(payload, affected_value.next)?
    if insert_value.next + 4 > payload.length() {
        return Err(error_kind("mysql", "truncated OK packet"))
    }
    let result = empty_result()
    result.affected = affected_value.value
    result.last_insert_id = insert_value.value
    result.warnings = read_int2_le(payload, insert_value.next + 2)
    return Ok(result)
}

fun is_eof_packet(payload: str) -> bool {
    return payload.length() > 0 and payload.length() < 9 and byte_at(payload, 0) == 254
}

fun eof_warnings(payload: str) -> int {
    if payload.length() >= 5 {
        return read_int2_le(payload, 1)
    }
    return 0
}

fun read_query_response(stream: TcpStream, first_sequence: int) -> Result[QueryResult, Error] {
    let first = read_packet_from(stream, first_sequence)?
    var expected_sequence = (first.sequence + 1) & 255
    if first.payload.length() == 0 {
        return Err(error_kind("mysql", "empty query response"))
    }
    let marker = byte_at(first.payload, 0)
    if marker == 255 {
        return Err(parse_server_error(first.payload))
    }
    if marker == 0 {
        return parse_ok(first.payload)
    }
    if marker == 251 {
        // Refuse LOCAL INFILE without leaving the connection waiting for a
        // client file upload. An empty packet ends the upload exchange; consume
        // the server's final response before returning the policy error.
        let next_sequence = write_packet(stream, "", expected_sequence)?
        let final_packet = read_packet_from(stream, next_sequence)?
        if final_packet.payload.length() > 0 and byte_at(final_packet.payload, 0) == 255 {
            let _ = parse_server_error(final_packet.payload)
        }
        return Err(error_kind("mysql", "LOCAL INFILE requests are not supported"))
    }

    let count_value = read_lenenc_checked(first.payload, 0)?
    if count_value.is_null or count_value.value < 1 {
        return Err(error_kind("mysql", "malformed result-set header"))
    }
    let result = empty_result()
    var i = 0
    while i < count_value.value {
        let packet = read_packet_from(stream, expected_sequence)?
        expected_sequence = (packet.sequence + 1) & 255
        if packet.payload.length() > 0 and byte_at(packet.payload, 0) == 255 {
            return Err(parse_server_error(packet.payload))
        }
        let column = parse_column(packet.payload)?
        result.columns.push(column.name)
        result.fields.push(column)
        i = i + 1
    }

    let column_end = read_packet_from(stream, expected_sequence)?
    expected_sequence = (column_end.sequence + 1) & 255
    if not is_eof_packet(column_end.payload) {
        return Err(error_kind("mysql", "missing result-set column terminator"))
    }

    var done = false
    while not done {
        let packet = read_packet_from(stream, expected_sequence)?
        expected_sequence = (packet.sequence + 1) & 255
        if is_eof_packet(packet.payload) {
            result.warnings = eof_warnings(packet.payload)
            done = true
        } else if packet.payload.length() > 0 and byte_at(packet.payload, 0) == 255 {
            return Err(parse_server_error(packet.payload))
        } else {
            result.rows.push(parse_text_row(packet.payload, count_value.value)?)
        }
    }
    return Ok(result)
}

fun parse_handshake(payload: str) -> Result[Handshake, Error] {
    if payload.length() < 34 or byte_at(payload, 0) != 10 {
        return Err(error_kind("mysql", "unsupported or malformed server handshake"))
    }

    let version_end = find_nul(payload, 1)
    if version_end + 31 > payload.length() {
        return Err(error_kind("mysql", "truncated server handshake"))
    }

    let server_version = payload.substring(1, version_end)
    let offset = version_end + 1
    let connection_id = read_int4_le(payload, offset)
    let scramble_first = payload.substring(offset + 4, offset + 12)
    let capability_low = read_int2_le(payload, offset + 13)
    let capability_high = read_int2_le(payload, offset + 18)
    let capabilities = capability_low | (capability_high << 16)
    let auth_length = byte_at(payload, offset + 20)
    let variable_offset = offset + 31

    var second_length = auth_length - 8
    if second_length < 13 {
        second_length = 13
    }
    if variable_offset + second_length > payload.length() {
        second_length = payload.length() - variable_offset
    }
    let scramble_second = strip_trailing_nul(
        payload.substring(variable_offset, variable_offset + second_length),
    )
    var scramble = scramble_first.concat(scramble_second)
    if auth_length > 0 and scramble.length() >= auth_length {
        scramble = scramble.substring(0, auth_length - 1)
    }

    let plugin_offset = variable_offset + second_length
    var plugin = "mysql_native_password"
    if plugin_offset < payload.length() {
        let plugin_end = find_nul(payload, plugin_offset)
        plugin = payload.substring(plugin_offset, plugin_end)
    }

    return Ok(
        Handshake(
            capabilities: capabilities,
            scramble: scramble,
            plugin: plugin,
            server_version: server_version,
            connection_id: connection_id,
        ),
    )
}

fun client_capabilities(database: str) -> int {
    var caps = CLIENT_LONG_PASSWORD | CLIENT_LONG_FLAG | CLIENT_PROTOCOL_41 | CLIENT_TRANSACTIONS | CLIENT_SECURE_CONNECTION | CLIENT_PLUGIN_AUTH
    if database.length() > 0 {
        caps = caps | CLIENT_CONNECT_WITH_DB
    }
    return caps
}

fun handshake_response(
    handshake: Handshake,
    user: str,
    password: str,
    database: str,
) -> Result[str, Error] {
    if handshake.plugin != "" and handshake.plugin != "mysql_native_password" {
        return Err(error_kind("mysql", "unsupported authentication plugin: ${handshake.plugin}"))
    }

    let required = CLIENT_PROTOCOL_41 | CLIENT_SECURE_CONNECTION | CLIENT_PLUGIN_AUTH
    if handshake.capabilities & required != required {
        return Err(
            error_kind("mysql", "server does not support the required 4.1 protocol capabilities"),
        )
    }
    if database.length() > 0 and handshake.capabilities & CLIENT_CONNECT_WITH_DB == 0 {
        return Err(error_kind("mysql", "server does not support selecting a database during handshake"))
    }

    let caps = client_capabilities(database) & handshake.capabilities
    let token = native_password_token(password, handshake.scramble)
    var response = int4_le(caps).concat(int4_le(16777216))
    response = response.concat(byte(UTF8MB4_GENERAL_CI)).concat(zeroes(23))
    response = response.concat(cstr(user))
    response = response.concat(byte(token.length())).concat(token)
    if database.length() > 0 {
        response = response.concat(cstr(database))
    }
    response = response.concat(cstr("mysql_native_password"))
    return Ok(response)
}

fun parse_auth_switch(packet_payload: str) -> Result[AuthSwitch, Error] {
    if packet_payload.length() < 2 or byte_at(packet_payload, 0) != 254 {
        return Err(error_kind("mysql", "malformed authentication switch request"))
    }
    let plugin_end = find_nul(packet_payload, 1)
    if plugin_end >= packet_payload.length() {
        return Err(error_kind("mysql", "malformed authentication switch request"))
    }
    let plugin = packet_payload.substring(1, plugin_end)
    if plugin.length() == 0 {
        return Err(error_kind("mysql", "authentication switch request has no plugin"))
    }
    if plugin_end + 1 >= packet_payload.length() {
        return Err(error_kind("mysql", "authentication switch request has no scramble"))
    }
    let scramble = strip_trailing_nul(
        packet_payload.substring(plugin_end + 1, packet_payload.length()),
    )
    if scramble.length() == 0 {
        return Err(error_kind("mysql", "authentication switch request has no scramble"))
    }
    return Ok(AuthSwitch(plugin: plugin, scramble: scramble))
}

fun finish_authentication(
    stream: TcpStream,
    packet_payload: str,
    sequence: int,
    password: str,
) -> Result[bool, Error] {
    if packet_payload.length() == 0 {
        return Err(error_kind("mysql", "empty authentication response"))
    }
    let marker = byte_at(packet_payload, 0)
    if marker == 0 {
        return Ok(true)
    }
    if marker == 255 {
        return Err(parse_server_error(packet_payload))
    }
    if marker == 254 {
        let auth_switch = parse_auth_switch(packet_payload)?
        if auth_switch.plugin != "mysql_native_password" {
            return Err(error_kind("mysql", "unsupported authentication plugin: ${auth_switch.plugin}"))
        }
        let next_sequence = write_packet(
            stream,
            native_password_token(password, auth_switch.scramble),
            (sequence + 1) & 255,
        )?
        let final_packet = read_packet_from(stream, next_sequence)?
        if final_packet.payload.length() > 0 and byte_at(final_packet.payload, 0) == 0 {
            return Ok(true)
        }
        if final_packet.payload.length() > 0 and byte_at(final_packet.payload, 0) == 255 {
            return Err(parse_server_error(final_packet.payload))
        }
        return Err(error_kind("mysql", "unexpected response after authentication switch"))
    }
    return Err(error_kind("mysql", "unexpected authentication response ${marker}"))
}

fun establish_connection(
    stream: TcpStream,
    user: str,
    password: str,
    database: str,
) -> Result[Connection, Error] {
    let greeting = read_packet_from(stream, 0)?
    let handshake = parse_handshake(greeting.payload)?
    let response = handshake_response(handshake, user, password, database)?
    let next_sequence = write_packet(stream, response, (greeting.sequence + 1) & 255)?
    let auth = read_packet_from(stream, next_sequence)?
    finish_authentication(stream, auth.payload, auth.sequence, password)?
    return Ok(
        Connection(
            stream: stream,
            server_version: handshake.server_version,
            connection_id: handshake.connection_id,
        ),
    )
}

// Connect with a read/write timeout for authentication and later commands.
// A non-positive timeout restores blocking socket behavior.
fun connect_with_timeout(
    host: str,
    port: int,
    user: str,
    password: str,
    database: str,
    timeout_ms: int,
) -> Result[Connection, Error] {
    let stream = net.connect("${host}:${port}")?
    stream.set_read_timeout_ms(timeout_ms)
    stream.set_write_timeout_ms(timeout_ms)
    return match establish_connection(stream, user, password, database) {
        case Ok(connection) { Ok(connection) }
        case Err(e) {
            stream.close()
            Err(e)
        }
    }
}

// Connect to a MySQL server using mysql_native_password authentication and a
// 30-second socket timeout.
fun connect(
    host: str,
    port: int,
    user: str,
    password: str,
    database: str,
) -> Result[Connection, Error] {
    return connect_with_timeout(host, port, user, password, database, 30000)
}

fun read_simple_command_response(
    stream: TcpStream,
    command_name: str,
    first_sequence: int,
) -> Result[bool, Error] {
    let packet = read_packet_from(stream, first_sequence)?
    if packet.payload.length() == 0 {
        return Err(error_kind("mysql", "empty ${command_name} response"))
    }
    let marker = byte_at(packet.payload, 0)
    if marker == 0 {
        let _ = parse_ok(packet.payload)?
        return Ok(true)
    }
    if marker == 255 {
        return Err(parse_server_error(packet.payload))
    }
    return Err(error_kind("mysql", "unexpected ${command_name} response ${marker}"))
}

impl Connection {
    // Change the socket timeout used by subsequent reads and writes.
    fun set_timeout_ms(self, timeout_ms: int) {
        self.stream.set_read_timeout_ms(timeout_ms)
        self.stream.set_write_timeout_ms(timeout_ms)
    }

    // Ask the server to verify that this connection is alive.
    fun ping(self) -> Result[bool, Error] {
        let next_sequence = write_packet(self.stream, byte(14), 0)?
        return read_simple_command_response(self.stream, "PING", next_sequence)
    }

    // Change the default database for this connection with COM_INIT_DB.
    fun select_database(self, database: str) -> Result[bool, Error] {
        let next_sequence = write_packet(self.stream, byte(2).concat(database), 0)?
        return read_simple_command_response(self.stream, "INIT_DB", next_sequence)
    }

    // Run SQL and collect either a result set or write metadata.
    fun query(self, sql: str) -> Result[QueryResult, Error] {
        let next_sequence = write_packet(self.stream, byte(3).concat(sql), 0)?
        return read_query_response(self.stream, next_sequence)
    }

    // Run SQL and return its affected-row count.
    fun execute(self, sql: str) -> Result[int, Error] {
        let result = self.query(sql)?
        return Ok(result.affected)
    }

    // Run SQL with `?` placeholders. Values are emitted as hexadecimal text
    // literals and are never interpreted as SQL syntax.
    fun query_params(self, sql: str, params: list[str]) -> Result[QueryResult, Error] {
        return self.query(bind_sql_params(sql, text_params(params))?)
    }

    // Parameterized query variant that can bind SQL NULL with `None`.
    fun query_optional_params(
        self,
        sql: str,
        params: list[Option[str]],
    ) -> Result[QueryResult, Error] {
        return self.query(bind_sql_params(sql, params)?)
    }

    // Parameterized query for sessions using NO_BACKSLASH_ESCAPES. The mode
    // changes how quotes in SQL source are scanned; bound values remain hex
    // literals in both modes.
    fun query_optional_params_no_backslash_escapes(
        self,
        sql: str,
        params: list[Option[str]],
    ) -> Result[QueryResult, Error] {
        return self.query(bind_sql_params_no_backslash_escapes(sql, params)?)
    }

    fun query_params_no_backslash_escapes(
        self,
        sql: str,
        params: list[str],
    ) -> Result[QueryResult, Error] {
        return self.query_optional_params_no_backslash_escapes(sql, text_params(params))
    }

    fun execute_params(self, sql: str, params: list[str]) -> Result[int, Error] {
        let result = self.query_params(sql, params)?
        return Ok(result.affected)
    }

    fun execute_optional_params(self, sql: str, params: list[Option[str]]) -> Result[int, Error] {
        let result = self.query_optional_params(sql, params)?
        return Ok(result.affected)
    }

    fun execute_optional_params_no_backslash_escapes(
        self,
        sql: str,
        params: list[Option[str]],
    ) -> Result[int, Error] {
        let result = self.query_optional_params_no_backslash_escapes(sql, params)?
        return Ok(result.affected)
    }

    fun execute_params_no_backslash_escapes(
        self,
        sql: str,
        params: list[str],
    ) -> Result[int, Error] {
        let result = self.query_params_no_backslash_escapes(sql, params)?
        return Ok(result.affected)
    }

    // Send COM_QUIT and close the socket. Best effort.
    fun close(self) {
        let _ = write_packet(self.stream, byte(1), 0)
        self.stream.close()
    }
}

impl Row {
    // Text value at zero-based column index `index`.
    fun get(self, index: int) -> str {
        return self.values[index]
    }

    // Whether the value at zero-based column index `index` is SQL NULL.
    fun is_null(self, index: int) -> bool {
        return self.nulls[index]
    }
}

impl QueryResult {
    // Number of rows returned by the statement.
    fun row_count(self) -> int {
        return self.rows.len()
    }
}
